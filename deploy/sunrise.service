# systemd unit for the Sunrise Drilling Django app (gunicorn).
# Matches the live server: app in /home/deploy/sites/sunrise, port 8110.
# Install: sudo cp deploy/sunrise.service /etc/systemd/system/sunrise.service
#          sudo systemctl daemon-reload && sudo systemctl enable --now sunrise
[Unit]
Description=gunicorn sunrise drilling (sunrise.mtirop.com)
After=network.target

[Service]
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/sites/sunrise
EnvironmentFile=/home/deploy/sites/sunrise/env
ExecStart=/home/deploy/sites/sunrise/.venv/bin/gunicorn sunrise_drilling_django.wsgi:application \
    --workers 2 \
    --bind 127.0.0.1:8110 \
    --access-logfile - \
    --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
