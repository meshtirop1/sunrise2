# Copy to the VPS environment (e.g. systemd service EnvironmentFile or ~/.env)
# and fill in real values. Never commit real secrets.

# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# Must be False in production
DJANGO_DEBUG=False

# Comma-separated, no spaces
DJANGO_ALLOWED_HOSTS=sunrisedrillingltd.com,www.sunrisedrillingltd.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://sunrisedrillingltd.com,https://www.sunrisedrillingltd.com

# Email: proposals/quotations + contact form notifications.
# For Gmail, create an App Password: Google Account -> Security ->
# 2-Step Verification -> App passwords. Without EMAIL_HOST_PASSWORD set,
# emails are only printed to the console (development mode).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=sunrisedrillingltd@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=sunrisedrillingltd@gmail.com
